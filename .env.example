# --- Required -------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456:replace-me

# --- Access control -------------------------------------------------------
# Comma-separated Telegram chat ids the bot is allowed to serve.
# Add the bot to your group, send /chatid there, and paste the id here.
# Groups that are not listed here (and not already registered) are ignored.
ALLOWED_CHAT_IDS=

# Comma-separated Telegram user ids that are always admins (send /chatid to see yours).
# Group admins are recognised automatically when the bot is a group admin too;
# this setting is the guaranteed way to get the first admin.
ADMIN_USER_IDS=

# --- Storage --------------------------------------------------------------
# Local development (zero setup):
DATABASE_URL=sqlite+aiosqlite:///./qul_bot.db
# Production (docker compose uses this one):
# DATABASE_URL=postgresql+asyncpg://qul:qul@localhost:5432/qul_bot

# --- Defaults for new workspaces -----------------------------------------
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LOCALE=uz

LOG_LEVEL=INFO
