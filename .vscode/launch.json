{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run bot",
      "type": "debugpy",
      "request": "launch",
      "module": "qul_bot",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Apply database migrations",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": ["upgrade", "head"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
